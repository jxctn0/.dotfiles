# =========================
# Dotfiles Zsh Entry Point
# =========================

DOTFILES="$HOME/.dotfiles/zsh"

# Instant prompt (keep near top)
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

source "$DOTFILES/env.zsh"

if [[ "$OSTYPE" == "darwin"* ]]; then
  source "$DOTFILES/macos.zsh"
else
  source "$DOTFILES/linux.zsh"
fi

source "$DOTFILES/prompt.zsh"
source "$DOTFILES/plugins.zsh"
source "$DOTFILES/aliases.zsh"
source "$DOTFILES/tools.zsh"
