{
    "pkg_termux": {
        "detect_command": "pkg",
        "os": "android",
        "command": "pkg",
        "install": "pkg install -y",
        "update": "pkg upgrade -y",
        "list": "pkg list-installed"
    },
    "apt": {
        "detect_command": "apt",
        "os": "debian",
        "command": "apt",
        "install": "sudo apt install -y",
        "update": "sudo apt update && sudo apt upgrade -y",
        "list": "apt list --upgradable"
    },
    "brew": {
        "detect_command": "brew",
        "os": "any",
        "command": "brew",
        "install": "brew install -y",
        "update": "brew upgrade -y",
        "list": "brew outdated"
    },
    "pacman": {
        "detect_command": "pacman",
        "os": "arch",
        "command": "pacman",
        "install": "sudo pacman -S --noconfirm",
        "update": "sudo pacman -Syu --noconfirm",
        "list": "pacman -Q"
    },
    "dnf": {
        "detect_command": "dnf",
        "os": "rhel",
        "command": "dnf",
        "install": "sudo dnf install -y",
        "update": "sudo dnf upgrade -y",
        "list": "dnf list installed"
    },
    "yum": {
        "detect_command": "yum",
        "os": "arch",
        "command": "yum",
        "install": "sudo yum install -y",
        "update": "sudo yum update -y",
        "list": "yum list installed"
    },
    "apk": {
        "detect_command": "apk",
        "os": "alpine",
        "command": "apk",
        "install": "sudo apk add",
        "update": "sudo apk update && sudo apk upgrade",
        "list": "apk info"
    }
}